%config(generator=internal);
#import <UIKit/UIKit.h>

// Edit this source; the sibling .mm is regenerated by Logos before compilation.
// The internal backend supports Objective-C method hooks, but not %hookf.
%hook UIViewController
- (void)viewDidAppear:(BOOL)animated {
    %orig(animated);
    static BOOL logged;
    if (!logged) {
        logged = YES;
        NSLog(@"[MonkeyDev] Logos hook executed: %@", NSStringFromClass(self.class));
    }
}
%end

%ctor {
    NSLog(@"[MonkeyDev] Logos constructor loaded");
    %init;
}
